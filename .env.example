# ── Solana
# mainnet-beta (default) | devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Server RPC: use a keyed provider (Helius, Triton…). The public endpoint rate-limits hard.
SOLANA_RPC_URL=
# The vault wallet: base58 secret or [1,2,...] JSON array. Server only — never NEXT_PUBLIC.
# Empty = deposits, trading and withdrawals answer "opens soon".
VAULT_SECRET_KEY=

# ── Storage (required on Vercel: the ledger must be durable)
# Postgres connection string (Neon, Supabase, Vercel Postgres). Empty = PGlite in ./data/pglite (local only).
DATABASE_URL=

# ── Token
# $BLINDSPOT mint once launched. Empty = CA shows "—", no buybacks, base fee for everyone.
NEXT_PUBLIC_MINT=
# Fee per vault swap (bps) and holder tiers "minWholeTokens:bps,…"
FEE_BPS=50
FEE_TIERS=1000000:40,10000000:30,50000000:20
# Share of fees that buys $BLINDSPOT (bps), and the minimum pool value (USD) before a buyback runs
BUYBACK_SHARE_BPS=5000
BUYBACK_MIN_USD=5

# ── Limits (whole units)
CAP_DEPOSIT_SOL=25
CAP_ACCOUNT_SOL=100
CAP_DEPOSIT_USDC=2500
CAP_ACCOUNT_USDC=10000

# ── Screening
# Default: daily OFAC SDN extract of Solana addresses (github.com/0xB10C/ofac-sanctioned-digital-currency-addresses)
SANCTIONS_LIST_URL=
# Extra addresses to refuse, comma-separated
EXTRA_BLOCKED_ADDRESSES=

# ── Jobs and sessions
# Bearer token for GET /api/cron/run (call it every minute)
CRON_SECRET=
# 32+ random characters (default: derived from VAULT_SECRET_KEY)
SESSION_SECRET=

# ── Optional
# JUPITER_API_URL=https://lite-api.jup.ag
# JUPITER_API_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_X_HANDLE=blindspotsol
